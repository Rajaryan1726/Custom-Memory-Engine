# Qdrant (local, via docker-compose)
# Port 6333 on this machine is already taken by another Qdrant, so we use 6337.
QDRANT_URL=http://localhost:6337
QDRANT_PORT=6337
# Optional: only needed for Qdrant Cloud or a secured instance
QDRANT_API_KEY=

# OpenAI
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
# Optional: model for the eval judge (scripts/judge.js). Falls back to gpt-4o-mini if unset.
JUDGE_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Memory
MEMORY_COLLECTION=custom_user_memories
