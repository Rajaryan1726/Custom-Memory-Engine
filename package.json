{
  "name": "custom-memory-engine",
  "version": "0.1.0",
  "description": "A memory layer for AI apps (Mem0-style), backed by Qdrant and OpenAI.",
  "type": "module",
  "exports": "./src/index.js",
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f qdrant",
    "check": "node scripts/check-setup.js",
    "check:library": "node scripts/check-library.js",
    "test:llm": "node scripts/test-llm.js",
    "test:store": "node scripts/test-vector-store.js",
    "playground": "node scripts/playground.js",
    "playground:naive": "node scripts/playground.js --naive",
    "eval:extraction": "node scripts/eval-extraction.js",
    "eval:extraction:extended": "node scripts/eval-extraction-extended.js",
    "eval:extraction:all": "node scripts/eval-extraction.js && node scripts/eval-extraction-extended.js",
    "judge:calibrate": "node scripts/judge-calibrate.js",
    "eval:retrieval": "node scripts/eval-retrieval.js",
    "eval:robustness": "node scripts/eval-robustness.js",
    "eval:update": "node scripts/eval-update.js",
    "eval:update:9a": "node scripts/eval-update.js --only=9a,9b",
    "eval:pref-stability": "node scripts/eval-preference-stability.js",
    "eval:context": "node scripts/eval-context.js",
    "eval:perf": "node scripts/eval-perf.js",
    "eval:report": "node scripts/eval-full-report.js",
    "eval:mem0-compare": "node scripts/eval-mem0-compare.js"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@qdrant/js-client-rest": "^1.19.0",
    "openai": "^7.23.0"
  },
  "devDependencies": {
    "dotenv": "^18.0.4",
    "mem0ai": "3.1.6"
  }
}
